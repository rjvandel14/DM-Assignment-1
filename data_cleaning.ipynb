   "source": [
    "median_vars = ['mood', 'circumplex.arousal', 'circumplex.valence', 'activity']\n",
    "sum_vars = [v for v in df['variable'].unique() if v not in median_vars]  \n",
    "\n",
    "median_group = df[df['variable'].isin(median_vars)].copy()\n",
    "median_agg = (median_group.groupby(['id', 'date', 'variable'])['value'].median().reset_index())\n",
    "\n",
    "# Step 3: Sum aggregation\n",
    "sum_group = df[df['variable'].isin(sum_vars)].copy()\n",
    "sum_agg = (sum_group.groupby(['id', 'date', 'variable'])['value'].sum().reset_index())\n",
    "\n",
    "# Step 4: Combine the two\n",
    "combined = pd.concat([median_agg, sum_agg], ignore_index=True)\n",
    "\n",
    "# Step 5: Pivot to wide format\n",
    "daily_summary = combined.pivot(index=['id', 'date'], columns='variable', values='value').reset_index()\n",
    "\n",
    "# Optional: Remove multi-index from columns\n",
    "daily_summary.columns.name = None\n",
    "daily_summary"
   ]
  }
